# OpenAI provider credential. Needed when applying a saved plan.
OPENAI_API_KEY=

# Kong Konnect personal access token and region (for example us or eu).
KONNECT_PAT=
KONNECT_REGION=us

# Docker host settings. If the HTTP port changes, update ai-gateway.yaml and replan.
AIGW_CONTAINER_NAME=summit-ai-demo-data-plane
AIGW_PROXY_PORT=8000
AIGW_PROXY_TLS_PORT=8443

# Optional image override; the helper defaults to the verified 2.0.3 image digest.
# KONG_AI_GATEWAY_IMAGE=kong/kong-ai-gateway:2.0.3
